{
  "sources": [
    "src"
  ],
  "test_roots": [
    "src/tests.zig"
  ],
  "test_support": [
    "src/testing/**"
  ],
  "test_dependencies": [
    "shakedown"
  ],
  "function_exceptions": {},
  "layout_exceptions": {},
  "docs": {
    "zig build docs -- usage": {
      "source": "examples/usage.zig",
      "region": "usage",
      "imports": [
        "sweep"
      ]
    },
    "zig build docs -- pattern": {
      "source": "examples/usage.zig",
      "region": "pattern",
      "imports": [
        "sweep"
      ]
    },
    "zig build docs -- set": {
      "source": "examples/usage.zig",
      "region": "set",
      "imports": [
        "sweep"
      ]
    }
  },
  "ziglint_exceptions": "ci/ziglint-exceptions.json",
  "extra_checks": [
    [
      "zig",
      "build",
      "check-consumer"
    ],
    [
      "zig",
      "build",
      "check-freestanding"
    ]
  ],
  "unreachable_exceptions": "ci/unreachable-exceptions.json",
  "debug_print_exceptions": "ci/debug-print-exceptions.json",
  "file_name_exceptions": "ci/file-name-exceptions.json"
}
