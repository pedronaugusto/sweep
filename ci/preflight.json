{
  "sources": [
    "src"
  ],
  "test_roots": [
    "src/tests.zig"
  ],
  "test_support": [
    "src/testing/**"
  ],
  "test_dependencies": [
    "shakedown"
  ],
  "shipped": {
    "docs/design.md": "Published architecture and ownership contracts accompany the package and the README design link."
  },
  "function_exceptions": {},
  "layout_exceptions": {},
  "docs": {
    "zig build docs -- usage": {
      "source": "examples/usage.zig",
      "region": "usage",
      "imports": [
        "sweep"
      ]
    },
    "zig build docs -- pattern": {
      "source": "examples/usage.zig",
      "region": "pattern",
      "imports": [
        "sweep"
      ]
    },
    "zig build docs -- set": {
      "source": "examples/usage.zig",
      "region": "set",
      "imports": [
        "sweep"
      ]
    },
    "zig build docs -- walk": {
      "source": "examples/usage.zig",
      "region": "walk",
      "imports": [
        "sweep"
      ]
    }
  },
  "extra_checks": [
    [
      "zig",
      "build",
      "check-consumer"
    ],
    [
      "zig",
      "build",
      "check-freestanding"
    ]
  ],
  "glint": {
    "rules": [
      {
        "id": "A004",
        "level": "gate"
      },
      {
        "id": "Z026",
        "level": "gate"
      }
    ]
  },
  "glint_paths": [
    "src",
    "bench",
    "examples",
    "ci",
    "build.zig"
  ]
}
